# Copie para .env e preencha. O .env nunca vai para o repositório.
MODO_SIMULADO=true

# GenAI (opcional: use LLM local via Ollama ou uma API gratuita)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
GROQ_API_KEY=

# RPA: e-mail de teste (nunca uma caixa real de cidadão)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# IoT
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
