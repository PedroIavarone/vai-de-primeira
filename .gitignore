# segredos
.env

# python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# node
node_modules/
dist/

# dados e modelos grandes (baixar pelos scripts, não versionar)
visao/datasets/
visao/runs/
*.zip

# sistema
.DS_Store

# pesos baixados automaticamente pelo YOLO
visao/*.pt

# índice vetorial e páginas brutas do assistente (regeneráveis)
genai/indice/
genai/fontes/brutas/

# saídas de execução do robô (logs, banco, e-mails de teste, relatórios)
rpa/saida/

# Node-RED: só o fluxo e o package.json vão para o repositório
iot/node-red/*
!iot/node-red/flows.json
!iot/node-red/package.json
!iot/node-red/package-lock.json
iot/dados/

# configuração local do editor
.claude/
